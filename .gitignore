# Build and Release Folders
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/

# Other files and folders
.settings/

# Executables
*.swf
*.air
*.ipa
*.apk

# Project files, i.e. `.project`, `.actionScriptProperties` and `.flexProperties`
# should NOT be excluded as they contain compiler settings and other important
# information for Eclipse / Flash Builder.
# ═══════════════════════════════════════════════════════════════════════════════
# NEXUS LANGFIX — .gitignore
# Auteur : Aissa Mohammedi (DGK) — NEXUS-OPEN-3.0
# ═══════════════════════════════════════════════════════════════════════════════

# --- Extension Build Artifacts ---
*.xpi
*.zip
*.crx
*.pem
*.sig

# --- NEXUS LangFix Specific ---
Nexus-LangFix/
Nexus-LangFix.xpi

# --- Node.js (si tu ajoutes des outils de build) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.pnpm-debug.log*

# --- Python (si tu ajoutes des scripts) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
pythonenv/

# --- IDE & Editors ---
.vscode/
.vscode/*
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.fleet/
.nvim/
*.sublime-project
*.sublime-workspace

# --- OS Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.fuse_hidden*
.Trash-*

# --- Secrets & Config ---
.env
.env.local
.env.*.local
secrets.json
config.local.json
*.pem
*.key
*.crt
credentials.json

# --- Temporary Files ---
*.tmp
*.temp
*.bak
*.backup
*.old
*.pid
*.log
