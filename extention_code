#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════════
# NEXUS LANGFIX — Fixateur de langue Firefox
# Force la langue d'affichage sur toutes les pages web.
# Auteur : Aissa Mohammedi (DGK)
# ═══════════════════════════════════════════════════════════════════════════════

set -euo pipefail

# Détection du Bureau
if [ -d "$HOME/Desktop" ]; then
    DESKTOP="$HOME/Desktop"
elif [ -d "$HOME/Bureau" ]; then
    DESKTOP="$HOME/Bureau"
else
    DESKTOP="$HOME"
fi

EXT_NAME="Nexus-LangFix"
EXT_DIR="$DESKTOP/$EXT_NAME"

echo -e "\033[1;36m╔══════════════════════════════════════════════════════════════╗\033[0m"
echo -e "\033[1;36m║   NEXUS LANGFIX — BUILDER                                   ║\033[0m"
echo -e "\033[1;36m╚══════════════════════════════════════════════════════════════╝\033[0m"

rm -rf "$EXT_DIR"
mkdir -p "$EXT_DIR"

# ─── 1. manifest.json ───
cat > "$EXT_DIR/manifest.json" << 'EOF'
{
  "manifest_version": 3,
  "name": "Nexus LangFix",
  "version": "1.0.0",
  "description": "Force la langue désirée sur toutes les pages web, même quand Firefox bug.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nexus LangFix",
    "default_icon": {
      "48": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
EOF
echo -e "  \033[1;32m[✓]\033[0m manifest.json généré"

# ─── 2. background.js (Gestion de la config) ───
cat > "$EXT_DIR/background.js" << 'EOF'
// Initialisation de la langue par défaut au démarrage
browser.runtime.onInstalled.addListener(async () => {
    const data = await browser.storage.local.get("targetLang");
    if (!data.targetLang) {
        // Par défaut, on met le français
        await browser.storage.local.set({ targetLang: "fr" });
    }
});
EOF
echo -e "  \033[1;32m[✓]\033[0m background.js généré"

# ─── 3. content.js (Le cœur du fix) ───
cat > "$EXT_DIR/content.js" << 'EOF'
// Ce script s'exécute sur chaque page web

(async () => {
    // 1. Récupérer la langue cible depuis le stockage
    const data = await browser.storage.local.get("targetLang");
    const targetLang = data.targetLang || "fr";

    // 2. Forcer l'attribut lang de la balise <html>
    // C'est ce qui dit au navigateur comment afficher la page
    if (document.documentElement.lang !== targetLang) {
        document.documentElement.lang = targetLang;
        document.documentElement.setAttribute("xml:lang", targetLang);
    }

    // 3. Corriger les balises meta http-equiv="content-language"
    const metaLang = document.querySelector('meta[http-equiv="content-language"]');
    if (metaLang) {
        metaLang.setAttribute("content", targetLang);
    } else {
        const newMeta = document.createElement("meta");
        newMeta.setAttribute("http-equiv", "content-language");
        newMeta.setAttribute("content", targetLang);
        document.head.appendChild(newMeta);
    }

    // 4. Corriger les traductions automatiques (si le site force l'anglais sur certains éléments)
    // On cherche les balises qui ont un attribut lang différent et on le force
    const elementsWithLang = document.querySelectorAll('[lang]:not(html)');
    elementsWithLang.forEach(el => {
        if (el.getAttribute("lang") !== targetLang && el.getAttribute("lang") !== "fr") {
            el.setAttribute("lang", targetLang);
        }
    });

    // 5. Optionnel : Bloquer les tentatives de redirection basées sur la langue
    // Certains sites redirigent vers /en/ ou /fr/ en fonction de l'IP.
    // On ne peut pas facilement empêcher la redirection, mais on peut forcer la langue.
    
    console.log(`[Nexus LangFix] Langue forcée à: ${targetLang} sur ${window.location.href}`);
})();
EOF
echo -e "  \033[1;32m[✓]\033[0m content.js généré"

# ─── 4. popup.html (Interface) ───
cat > "$EXT_DIR/popup.html" << 'EOF'
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="header">
        <h1>🌍 NEXUS LANGFIX</h1>
        <p>Force ta langue sur le web.</p>
    </div>
    
    <div class="control-group">
        <label for="langSelect">Langue d'affichage :</label>
        <select id="langSelect">
            <option value="fr">Français (FR)</option>
            <option value="en">English (EN)</option>
            <option value="es">Español (ES)</option>
            <option value="de">Deutsch (DE)</option>
            <option value="it">Italiano (IT)</option>
            <option value="pt">Português (PT)</option>
            <option value="zh">中文 (ZH)</option>
            <option value="ja">日本語 (JA)</option>
            <option value="ru">Русский (RU)</option>
            <option value="ar">العربية (AR)</option>
        </select>
    </div>

    <button id="applyBtn">Appliquer</button>
    
    <div class="footer">
        <small>NEXUS-OPEN-3.0 · Aissa Mohammedi</small>
    </div>
