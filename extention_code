echo -e "  \033[1;32m[✓]\033[0m popup.html généré"

# ─── 5. popup.js (Logique du popup) ───
cat > "$EXT_DIR/popup.js" << 'EOF'
document.addEventListener('DOMContentLoaded', async () => {
    const select = document.getElementById('langSelect');
    const btn = document.getElementById('applyBtn');

    // Charger la langue sauvegardée
    const data = await browser.storage.local.get("targetLang");
    if (data.targetLang) {
        select.value = data.targetLang;
    }

    btn.addEventListener('click', async () => {
        const newLang = select.value;
        
        // 1. Sauvegarder
        await browser.storage.local.set({ targetLang: newLang });

        // 2. Appliquer à l'onglet actif immédiatement
        const tabs = await browser.tabs.query({ active: true, currentWindow: true });
        if (tabs[0] && tabs[0].id) {
            browser.scripting.executeScript({
                target: { tabId: tabs[0].id },
                func: (lang) => {
                    // Recharger le script de contenu avec la nouvelle langue
                    document.documentElement.lang = lang;
                    document.documentElement.setAttribute("xml:lang", lang);
                    console.log(`[Nexus LangFix] Langue mise à jour: ${lang}`);
                },
                args: [newLang]
            });
        }

        // Feedback visuel
        btn.textContent = "✅ Appliqué !";
        setTimeout(() => { btn.textContent = "Appliquer"; }, 2000);
    });
});
EOF
echo -e "  \033[1;32m[✓]\033[0m popup.js généré"

